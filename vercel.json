{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/hauling",
      "destination": "https://kp-hauling-backend.vercel.app/hauling"
    },
    {
      "source": "/hauling/:path*",
      "destination": "https://kp-hauling-backend.vercel.app/hauling/:path*"
    },
    { "source": "/(.*)", "destination": "/index" }
  ]
}
